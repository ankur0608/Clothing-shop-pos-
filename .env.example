# PostgreSQL Connection URLs (e.g. Neon, Supabase, or standard PostgreSQL)
# Pooled connection string (used by app runtime / connection pool)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/clothing_pos?sslmode=require"

# Direct connection string (used by Prisma migrations and CLI)
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/clothing_pos?sslmode=require"

# Authentication Secrets
JWT_SECRET="replace-with-a-secure-random-64-character-hex-secret"

